[Unit]
Description=GameTrade marketplace
After=network.target

[Service]
Type=simple
User=gametrade
Group=gametrade
WorkingDirectory=/opt/gametrade
EnvironmentFile=/etc/gametrade/gametrade.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
